# Public site URL (password-reset links, share URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Express API base URL. In the browser, /api/* is proxied via next.config rewrites.
# For server-side rendering (e.g. storefront pages), set this to the backend origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Comma-separated admin emails for post-login redirect and /admin layout gate.
# Must match ADMIN_EMAILS on the backend.
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
