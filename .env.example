# Copy to .env and fill in values (your real .env stays local and is gitignored).

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin (server-only; comma-separated emails) ---
ADMIN_EMAILS=you@example.com
# One-time key for POST /api/admin/setup (optional in production)
ADMIN_SETUP_KEY=

# --- Email (optional; set ENABLE_EMAIL=true to send) ---
ENABLE_EMAIL=false
RESEND_API_KEY=
FROM_EMAIL=pòlówó <noreply@yourdomain.com>

# --- Paystack (optional; platform billing is free — only if re-enabling payments) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_STANDARD_PLAN_CODE=
PAYSTACK_PRO_PLAN_CODE=
